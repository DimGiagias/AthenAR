# Dependencies
node_modules/

# Build output
dist/
.vite/
coverage/

# Local APK builds (npm run apk, CI's athenar.apk)
/*.apk

# Local settings and secrets
*.local
.env
.env.*

# Signing keys must never be committed
*.keystore
*.jks

# Android / Capacitor build output (android/.gitignore also covers these,
# plus the generated capacitor.config.json, capacitor.plugins.json and
# res/xml/config.xml)
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/app/src/main/assets/public/

# Logs
*.log

# Editors and OS files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
